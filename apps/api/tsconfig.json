{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@osint/types": ["../../packages/types/src/index.ts"],
      "@osint/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"]
    },
    "lib": ["ES2022"],
    "isolatedModules": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    // Without this, ts-node only compiles files as they're require()'d and
    // never eagerly loads tsconfig's `include` glob — so ambient .d.ts
    // declarations (src/types/exif-parser.d.ts) that nothing explicitly
    // imports are invisible to it, even though `tsc --noEmit` (which does
    // walk `include`) sees them fine. Bit us in `pnpm dev`, not in typecheck/
    // lint/build/docker, which is how it went unnoticed until now.
    "files": true
  }
}
